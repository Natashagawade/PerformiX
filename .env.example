# PerformiX — Environment Variables
# Copy this to .env.local and fill in your values

# === DATABASE ===
# Neon, Supabase, Railway, or any PostgreSQL
DATABASE_URL="postgresql://user:password@host:5432/performix?sslmode=require"

# === AUTH ===
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-min-32-chars"

# === APP ===
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# === ANTHROPIC (for GoalIQ AI) ===
# Note: In this setup, the API key is passed through the browser to Anthropic directly.
# For production, proxy through a server-side API route for security.
ANTHROPIC_API_KEY="sk-ant------"

# === OPTIONAL: OAuth Providers ===
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# AZURE_AD_CLIENT_ID=""
# AZURE_AD_CLIENT_SECRET=""
# AZURE_AD_TENANT_ID=""
